# ==============================================================================
# CONFIGURACIÓN DE RESEND (ENVÍO DE CORREOS DE ADMISIONES)
# ==============================================================================

# 1. Tu API Key de Resend (obtenla gratis en https://resend.com/api-keys)
RESEND_API_KEY=re_tu_api_key_aqui

# 2. Correo de destino donde la escuela recibirá los registros de prospectos
LEADS_RECEIVER_EMAIL=admisiones@institutoeverestleon.edu.mx

# 3. Remitente oficial
# Modo inicial/pruebas (dominio de prueba oficial de Resend):
RESEND_FROM_EMAIL=Instituto Everest <onboarding@resend.dev>

# Modo producción con dominio verificado en Resend (opcional):
# RESEND_FROM_EMAIL=Instituto Everest <admisiones@institutoeverestleon.edu.mx>

